{
  "name": "http2midi",
  "version": "1.4.3",
  "description": "A Webserver, which accepts HTTP-Requests and outputs MIDI Signals",
  "main": "index.js",
  "scripts": {
    "startup": "node index.js",
    "build": "pkg package.json --compress GZip"
  },
  "bin": {
    "http2midi": "./index.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ScheerleJo/http2midi/"
  },
  "keywords": [
    "HTTP",
    "MIDI",
    "Converter"
  ],
  "author": "Josia Scheerle",
  "license": "MIT",
  "dependencies": {
    "easymidi": "^3.2.0",
    "express": "^5.3.0",
    "find-process": "^2.1.1",
    "nconf": "^0.13.0",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "globals": "^17.14.0"
  },
  "pkg": {
    "assets": [
      "scripts/**/*",
      "config/**/*",
      "node_modules/**/*"
    ],
    "targets": [
      "node24-win-x64"
    ]
  },
  "overrides": {
    "swagger-jsdoc": {
      "glob": "^14.0.6"
    }
  }
}
